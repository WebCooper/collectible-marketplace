# -----------------------------------------------------------------------------
# LankaNumis client (Next.js) — environment template
#
# Copy this file to `.env.local` and adjust the values:
#     cp .env.example .env.local
#
# NEXT_PUBLIC_* values are inlined into the browser bundle at BUILD time
# (`next build`). Changing them later requires a rebuild.
# -----------------------------------------------------------------------------

# Base URL of the NestJS API in backend/ (no trailing slash).
# The browser calls it directly with `credentials: "include"`, so this origin
# must be listed in the backend's CORS_ORIGINS (default allows
# http://localhost:3000). The live-bidding Socket.IO namespace is served from
# the same origin at `${NEXT_PUBLIC_API_URL}/auctions`.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Show the "use a seeded demo account" helpers on the sign-in page.
# The seeded accounts only exist after `npm run prisma:seed` in backend/.
# Set to "false" for any shared or production deployment.
NEXT_PUBLIC_ENABLE_DEMO_ACCOUNTS=true
