# ---- Application ----
NODE_ENV=development
PORT=3001
# Comma-separated origins allowed to call the API (client + admin frontends)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- Database (Member 5 supplies the Cloud SQL URL in production) ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/collectible_marketplace?schema=public

# ---- Auth ----
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-too
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10
OTP_TTL_MINUTES=10
PASSWORD_RESET_TTL_MINUTES=30

# ---- Auction rules ----
# Window before close in which a new bid extends the auction (FR 2.1.5 Auto-Extend)
AUCTION_ANTI_SNIPE_WINDOW_SECONDS=120
AUCTION_ANTI_SNIPE_EXTENSION_SECONDS=120

# ---- External systems (owned by Member 4) ----
PAYMENT_PROVIDER=payhere
PAYMENT_MERCHANT_ID=
PAYMENT_SECRET=
SMS_API_KEY=

# ---- E-mail (Resend, https://resend.com) ----
# Leave RESEND_API_KEY empty to just log e-mails (handy for local development).
# Free plan: ~3,000 e-mails/month, 100/day. Until you verify a domain you own in
# the Resend dashboard you can only send to your own Resend account address.
RESEND_API_KEY=
# Must use a verified domain once you have one, e.g. "Collectible Marketplace <noreply@yourdomain.lk>"
EMAIL_FROM=Collectible Marketplace <onboarding@resend.dev>
# Public address of the client app; used for the links inside e-mails
CLIENT_URL=http://localhost:3000
GCP_PROJECT_ID=
GCS_BUCKET=
