// Sri Lankan Collectible Marketplace - data model
// Mirrors the class diagram in the Architecture Analysis & Design Report (Figure 5).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  BUYER
  SELLER
  APPRAISER
  ADMIN
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
}

enum TokenType {
  EMAIL_VERIFICATION
  PHONE_OTP
  PASSWORD_RESET
}

enum Category {
  OLD_COINS
  PROOF_COINS
  COMMEMORATIVE_COINS
  CURRENCY_NOTES
  STAMPS
  MEDALS
}

enum ItemCondition {
  POOR
  FAIR
  GOOD
  VERY_GOOD
  EXCELLENT
  MINT
}

enum ListingType {
  FIXED_PRICE
  AUCTION
}

enum ListingStatus {
  DRAFT
  UNDER_REVIEW
  ACTIVE
  SOLD
  EXPIRED
  WITHDRAWN
  REMOVED
}

enum CertificateStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VerificationDecision {
  APPROVED
  REJECTED
  MORE_EVIDENCE_REQUESTED
}

enum AuctionStatus {
  SCHEDULED
  ACTIVE
  ENDED
  CANCELLED
}

enum BidStatus {
  ACTIVE
  OUTBID
  WON
  LOST
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  INITIATED
  SUCCEEDED
  FAILED
  REFUNDED
}

enum NotificationType {
  OTP
  OUTBID
  AUCTION_STARTING
  AUCTION_ENDING
  AUCTION_WON
  AUCTION_CLOSED
  LISTING_APPROVED
  LISTING_REJECTED
  LISTING_FLAGGED
  ORDER_CONFIRMED
  PAYMENT_RECEIVED
  ITEM_SHIPPED
  DISPUTE_UPDATE
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
}

enum ReportTargetType {
  LISTING
  USER
}

enum ReportStatus {
  OPEN
  REVIEWING
  ACTIONED
  DISMISSED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id            String     @id @default(uuid())
  name          String
  email         String     @unique
  phone         String?
  passwordHash  String
  role          Role       @default(BUYER)
  status        UserStatus @default(PENDING_VERIFICATION)
  emailVerified Boolean    @default(false)
  phoneVerified Boolean    @default(false)
  avatarUrl     String?
  bio           String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  listings         Listing[]
  bids             Bid[]
  ordersAsBuyer    Order[]              @relation("BuyerOrders")
  ordersAsSeller   Order[]              @relation("SellerOrders")
  wonAuctions      Auction[]            @relation("AuctionWinner")
  verifications    VerificationRecord[] @relation("AppraiserVerifications")
  notifications    Notification[]
  tokens           AuthToken[]
  reportsFiled     Report[]             @relation("ReportAuthor")
  reportsAgainst   Report[]             @relation("ReportedUser")
  reportsResolved  Report[]             @relation("ReportResolver")
  disputesRaised   Dispute[]            @relation("DisputeAuthor")
  disputesResolved Dispute[]            @relation("DisputeResolver")
  auditLogs        AuditLog[]

  @@index([role, status])
}

/// OTP codes, e-mail verification links and password reset tokens.
/// Only the hash of the secret is persisted.
model AuthToken {
  id         String    @id @default(uuid())
  userId     String
  type       TokenType
  tokenHash  String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([tokenHash])
}

// ---------------------------------------------------------------------------
// Catalogue
// ---------------------------------------------------------------------------

model Listing {
  id            String        @id @default(uuid())
  sellerId      String
  title         String
  description   String
  category      Category
  condition     ItemCondition
  era           String?
  denomination  String?
  startingPrice Decimal       @db.Decimal(12, 2)
  listingType   ListingType   @default(FIXED_PRICE)
  status        ListingStatus @default(UNDER_REVIEW)
  isVerified    Boolean       @default(false)
  isFeatured    Boolean       @default(false)
  viewCount     Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  seller        User                 @relation(fields: [sellerId], references: [id])
  images        ListingImage[]
  certificates  Certificate[]
  verifications VerificationRecord[]
  auction       Auction?
  orders        Order[]
  reports       Report[]             @relation("ReportedListing")

  // Indexes backing the Advanced Filtering / Sorting requirements (FR 2.1.4).
  @@index([status, category])
  @@index([status, listingType])
  @@index([status, startingPrice])
  @@index([status, isVerified])
  @@index([createdAt])
}

model ListingImage {
  id        String   @id @default(uuid())
  listingId String
  url       String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
}

model Certificate {
  id         String            @id @default(uuid())
  listingId  String
  fileUrl    String
  fileName   String
  issuer     String?
  status     CertificateStatus @default(PENDING)
  uploadedAt DateTime          @default(now())

  listing       Listing              @relation(fields: [listingId], references: [id], onDelete: Cascade)
  verifications VerificationRecord[]

  @@index([listingId])
  @@index([status])
}

/// Immutable audit trail of every appraiser decision (FR 2.1.3 - Verification History).
model VerificationRecord {
  id             String               @id @default(uuid())
  listingId      String
  certificateId  String?
  appraiserId    String
  decision       VerificationDecision
  comments       String?
  appraisedValue Decimal?             @db.Decimal(12, 2)
  verifiedAt     DateTime             @default(now())

  listing     Listing      @relation(fields: [listingId], references: [id], onDelete: Cascade)
  certificate Certificate? @relation(fields: [certificateId], references: [id])
  appraiser   User         @relation("AppraiserVerifications", fields: [appraiserId], references: [id])

  @@index([listingId])
  @@index([appraiserId])
}

// ---------------------------------------------------------------------------
// Auctions
// ---------------------------------------------------------------------------

model Auction {
  id             String        @id @default(uuid())
  listingId      String        @unique
  startPrice     Decimal       @db.Decimal(12, 2)
  minIncrement   Decimal       @db.Decimal(12, 2)
  currentPrice   Decimal       @db.Decimal(12, 2)
  buyNowPrice    Decimal?      @db.Decimal(12, 2)
  startTime      DateTime
  endTime        DateTime
  status         AuctionStatus @default(SCHEDULED)
  winnerId       String?
  bidCount       Int           @default(0)
  /// Number of times auto-extend has fired for this auction.
  extensionCount Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  winner  User?   @relation("AuctionWinner", fields: [winnerId], references: [id])
  bids    Bid[]
  orders  Order[]

  // Backs the auction-closing sweep and the "ending soonest" sort.
  @@index([status, endTime])
}

model Bid {
  id        String    @id @default(uuid())
  auctionId String
  bidderId  String
  amount    Decimal   @db.Decimal(12, 2)
  status    BidStatus @default(ACTIVE)
  placedAt  DateTime  @default(now())

  auction Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  bidder  User    @relation(fields: [bidderId], references: [id])

  @@index([auctionId, amount])
  @@index([bidderId])
}

// ---------------------------------------------------------------------------
// Commerce
// ---------------------------------------------------------------------------

model Order {
  id                 String      @id @default(uuid())
  listingId          String
  auctionId          String?
  buyerId            String
  sellerId           String
  amount             Decimal     @db.Decimal(12, 2)
  status             OrderStatus @default(PENDING)
  shippingName       String
  shippingPhone      String
  shippingAddress    String
  shippingCity       String
  shippingPostalCode String
  trackingNumber     String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  listing Listing  @relation(fields: [listingId], references: [id])
  auction Auction? @relation(fields: [auctionId], references: [id])
  buyer   User     @relation("BuyerOrders", fields: [buyerId], references: [id])
  seller  User     @relation("SellerOrders", fields: [sellerId], references: [id])
  payment Payment?
  dispute Dispute?

  @@index([buyerId, status])
  @@index([sellerId, status])
}

model Payment {
  id             String        @id @default(uuid())
  orderId        String        @unique
  provider       String
  amount         Decimal       @db.Decimal(12, 2)
  status         PaymentStatus @default(INITIATED)
  /// Gateway reference; unique so replayed webhooks cannot double-charge (NFR Reliability).
  transactionRef String        @unique
  rawPayload     Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Notifications, moderation & audit
// ---------------------------------------------------------------------------

model Notification {
  id         String              @id @default(uuid())
  userId     String
  type       NotificationType
  title      String
  message    String
  channel    NotificationChannel @default(IN_APP)
  readStatus Boolean             @default(false)
  payload    Json?
  sentAt     DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readStatus])
}

model Report {
  id                String           @id @default(uuid())
  reporterId        String
  targetType        ReportTargetType
  reportedListingId String?
  reportedUserId    String?
  reason            String
  details           String?
  status            ReportStatus     @default(OPEN)
  resolutionNote    String?
  resolvedById      String?
  resolvedAt        DateTime?
  createdAt         DateTime         @default(now())

  reporter        User     @relation("ReportAuthor", fields: [reporterId], references: [id])
  reportedListing Listing? @relation("ReportedListing", fields: [reportedListingId], references: [id], onDelete: Cascade)
  reportedUser    User?    @relation("ReportedUser", fields: [reportedUserId], references: [id])
  resolvedBy      User?    @relation("ReportResolver", fields: [resolvedById], references: [id])

  @@index([status])
}

model Dispute {
  id           String        @id @default(uuid())
  orderId      String        @unique
  raisedById   String
  reason       String
  details      String?
  status       DisputeStatus @default(OPEN)
  resolution   String?
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime      @default(now())

  order      Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  raisedBy   User  @relation("DisputeAuthor", fields: [raisedById], references: [id])
  resolvedBy User? @relation("DisputeResolver", fields: [resolvedById], references: [id])

  @@index([status])
}

/// Supports the Audit & Logging non-functional requirement (Table 1).
model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt])
}
